spring.application.name=vtspoc

server.servlet.context-path=/vts
server.port=8082

# PostgreSQL Database Configuration
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.url=jdbc:postgresql://localhost:5432/mines_db
spring.datasource.username=postgres
spring.datasource.password=postgres@123

# JPA & Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=false
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.format_sql=true

# Logging Configuration
logging.level.org.hibernate.SQL=WARN
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=WARN
logging.level.com.project.rmaines=INFO

# VTS Server Target Configuration
vts.server.host=minesdata.rajasthan.gov.in
vts.server.port=7001
vts.packet.interval.ms=5000